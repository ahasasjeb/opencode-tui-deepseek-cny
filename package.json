{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "llm-cny",
  "version": "1.0.19",
  "description": "在 OpenCode TUI 右侧栏显示 DeepSeek V4、moonshot China 的人民币费用和账户余额，以及 Xiaomi MiMo、ZhipuAI GLM、Alibaba Cloud Qwen 的人民币费用。",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "deepseek",
    "kimi",
    "moonshot",
    "mimo",
    "xiaomi",
    "zhipuai",
    "glm",
    "alibaba",
    "qwen",
    "cny",
    "billing"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "engines": {
    "opencode": ">=1.15.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0",
    "@opentui/solid": ">=0.2.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "^1.15.5",
    "@opentui/solid": "^0.2.14",
    "@types/bun": "^1.3.13",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.10",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahasasjeb/opencode-tui-deepseek-cny.git"
  },
  "dependencies": {
    "bun-types": "^1.3.14"
  }
}
